/[Mm]emoryCaptures/

# ==========================================
# Meta SDK / VR & Android Specific
# ==========================================
# Never commit Android keystores to a public or shared repo
*.keystore
user.keystore

# Ignore Android build/cache folders
.gradle/
/[Aa]ssets/[Pp]lugins/[Aa]ndroid/assets/

# Ignore compiled Android packages
*.apk
*.aab

# Local Oculus Platform settings (prevents overriding team app IDs with local test IDs)
Oculus/Platform/LocalSettings*

